#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    [ -x "$(command -v update-mime-database)" ] && update-mime-database /usr/share/mime >/dev/null 2>&1 || true
    [ -x "$(command -v update-desktop-database)" ] && update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
fi
exit 0
